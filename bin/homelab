#!/usr/bin/env bash
set -euo pipefail

# ===== CONFIG =====
HOMELAB_DIR="$HOME/.local/share/homelab"
NVIM_CONFIG_DIR="$HOME/.config/nvim"         # For nvim update-config
COMPOSE_BASE_DIR="$HOME/.local/share/homelab/applications"

# ===== COLORS =====
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ===== FUNCTIONS =====
usage() {
    cat <<EOF
Usage: $0 <command> [subcommand] [options]

Commands:
  update
    Pulls the latest changes from git in $HOMELAB_DIR

  application
    status   # print current status of applications
    update   # update the applications based on config 

  nvim
    update   # Pulls latest config from git and runs PackerSync

  samba
    update   # Update samba config and shares

  config
    open the homelab config into nvim editor

Examples:
  $0 update
  $0 application status
  $0 application update
  $0 nvim update
  $0 samba update
EOF
    exit 1
}

error() {
    echo -e "${RED}Error:${NC} $*" >&2
    usage
}

# ====== HOMELAB UPDATE FUNCTION ======
update() {
    if [[ ! -d "$HOMELAB_DIR/.git" ]]; then
        error "No git repo found in $HOMELAB_DIR"
    fi
    echo -e "${GREEN}[UPDATE]${NC} Pulling latest changes in $HOMELAB_DIR..."
    git -C "$HOMELAB_DIR" pull origin main --ff-only
}

# ====== Application Functions ======
print_applications_status() {
    apps=()
    pattern=$(IFS='|'; echo "${apps[*]}")

    # Loop through each application in config
    yq -r '.applications | to_entries[] | "\(.key) \(.value.enable)"' "$HOMELAB_CONFIG" | \
    while read -r app enable_status; do
        compose_template="$COMPOSE_BASE_DIR/$app.yaml"
        RENDERED_APPLICATIONS_DIR="$COMPOSE_BASE_DIR/.current"
        if [ ! -d "$COMPOSE_BASE_DIR/.current" ]; then
            continue;
        fi
        compose_file="$RENDERED_APPLICATIONS_DIR/$app.yaml"

        # Skip if template file not found
        if [[ ! -f "$compose_template" ]]; then
            continue
        fi

        if [[ "$enable_status" == "true" ]]; then
            apps+=($app)
        fi
    done
    sudo docker ps --format "table {{.ID}}\t{{.Image}}\t{{.Names}}\t{{.Status}}" | grep -E "$pattern"
}

update_applications() {
    local application_name=$1
    update

    echo -e "${GREEN}[UPDATE]${NC} applying latest changes in on applications based on $HOMELAB_CONFIG"
    if [ "$application_name" == "" ]; then
        bash $HOME/.local/share/homelab/install/applications/manage
    else
        bash $HOME/.local/share/homelab/install/applications/manage --application $application_name
    fi
}

recreate_applications() {
    local application_name=$1
    update

    echo -e "${GREEN}[RECREATE]${NC} recreating applications based on $HOMELAB_CONFIG"
    if [ "$application_name" == "" ]; then
        bash $HOME/.local/share/homelab/install/applications/manage --recreate
    else
        bash $HOME/.local/share/homelab/install/applications/manage --recreate --application $application_name
    fi
}

down_applications() {
    local application_name=$1
    update

    echo -e "${GREEN}[RECREATE]${NC} recreating applications based on $HOMELAB_CONFIG"
    if [ "$application_name" == "" ]; then
        bash $HOME/.local/share/homelab/install/applications/manage --down
    else
        bash $HOME/.local/share/homelab/install/applications/manage --down --application $application_name
    fi
}

# ====== NVIM FUNCTIONS ======
nvim_update_config() {
    if [[ ! -d "$NVIM_CONFIG_DIR/.git" ]]; then
        error "No git repo found in $NVIM_CONFIG_DIR"
    fi
    echo -e "${GREEN}[NVIM]${NC} Pulling latest config from $NVIM_CONFIG_DIR..."
    git -C "$NVIM_CONFIG_DIR" pull origin main --ff-only
}

# ===== Samba Configuration Update =====
samba_configuration_update() {
    update

    echo -e "${GREEN}[UPDATE]${NC} updating latest samba configuration based on $HOMELAB_CONFIG"
    bash ~/.local/share/homelab/install/tools/samba.sh
}

# ===== Open Homelab configuration =====
open_homelab_config() {
    nvim "$HOMELAB_DIR/config.yaml"
}

# ====== MAIN SCRIPT ======
if [[ $# -lt 1 ]]; then
    usage
fi

main_cmd="$1"
shift || true

case "$main_cmd" in
    update)
        update
        ;;
    config)
        open_homelab_config
        ;;
    application)
        [[ $# -lt 1 ]] && error "Missing application subcommand"
        sub_cmd="$1"
        shift || true
        case "$sub_cmd" in
            status) print_applications_status ;;
            update) update_applications "${1:-}" ;;
            recreate) recreate_applications "${1:-}" ;;
            down) down_applications "${1:-}" ;;
            *) error "Unknown application subcommand: $sub_cmd" ;;
        esac
        ;;
    nvim)
        [[ $# -lt 1 ]] && error "Missing nvim subcommand"
        sub_cmd="$1"
        shift || true
        case "$sub_cmd" in
            update) nvim_update_config ;;
            *) error "Unknown nvim subcommand: $sub_cmd" ;;
        esac
        ;;
    samba)
        [[ $# -lt 1 ]] && error "Missing samba subcommand"
        sub_cmd="$1"
        shift || true
        case "$sub_cmd" in
            update) samba_configuration_update ;;
            *) error "Unknown samba subcommand: $sub_cmd" ;;
        esac
        ;;
    *)
        error "Unknown main command: $main_cmd"
        ;;
esac

