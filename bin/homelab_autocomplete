#!/usr/bin/env bash


_mytool_completions() {
    local cur prev words cword
    local HOMELAB_DIR="$HOME/.local/share/homelab"
    _init_completion || return

    # Top-level commands
    local commands="update config application nvim samba"

    # Nvim subcommands
    local nvim_sub="update"

    # Application subcommands
    local application_sub="status update recreate"

    # Generate application update subcommands from filenames
    local application_list="all"
    local update_dir="$HOMELAB_DIR/applications/.current"
    if [[ -d "$update_dir" ]]; then
        for f in "$update_dir"/*.yaml; do
            [[ -f "$f" ]] || continue
            name=$(basename "$f")
            name="${name%.*}"
            application_list+=" $name"
        done
    fi

    # Samba subcommand
    local samba_sub="update"

    case "${COMP_WORDS[1]}" in
        application)
            if [[ "${COMP_WORDS[2]}" == "update" || "${COMP_WORDS[2]}" == "recreate" ]]; then
                COMPREPLY=( $(compgen -W "$application_list" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "$application_sub" -- "$cur") )
            fi
            ;;
        nvim)
            COMPREPLY=( $(compgen -W "$nvim_sub" -- "$cur") )
            ;;
        samba)
            COMPREPLY=( $(compgen -W "$samba_sub" -- "$cur") )
            ;;
        *)
            COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
            ;;
    esac
}

# Register the completion for your script (change to your actual script name)
complete -F _mytool_completions homelab

